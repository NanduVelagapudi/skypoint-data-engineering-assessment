# Copy to .env to override defaults. docker compose reads .env automatically;
# every value here is optional and has a default in docker-compose.yml.

# Restricted raw layer (DuckDB). It contains raw PHI, so it must live outside
# the output directory. Container path, backed by the raw_work named volume.
RAW_DB_PATH=/work/raw.duckdb

# DEBUG, INFO, WARNING or ERROR. Logs are JSON on stdout and never contain PHI.
LOG_LEVEL=INFO

# Task 6 publish gate: a batch is not published when MORE than this share of its
# rows fail error-level data-quality checks. A decimal from 0 (any error blocks)
# to 1 (never blocks); 0.05 = 5%, the default.
DQ_GATE_MAX_ERROR_SHARE=0.05

# ---------------------------------------------------------------------------
# DEVELOPMENT-ONLY placeholder for the patient_key HMAC-SHA256 key (Task 3).
# REQUIRED: the pipeline exits with code 1 (MissingSecretError) if it is unset
# or blank. This is NOT a real secret: never use it outside local development,
# and never commit a real key. Changing the key changes every patient_key. In
# production the key comes from a secret store (e.g. Azure Key Vault), not a file.
# ---------------------------------------------------------------------------
PATIENT_KEY_HMAC_SECRET=dev-only-NOT-A-REAL-SECRET-replace-me

# Local (non-Docker) runs only. The pipeline reads plain environment variables
# (it does not load .env itself). Defaults shown; relative paths resolve
# against the current directory.
# DATA_DIR=data
# REFERENCE_DIR=data/reference
# OUTPUT_DIR=output
# RAW_DB_PATH=work/raw.duckdb
# SCHEMA_CONTRACT_PATH=config/schema_contracts.json
# FACILITY_ALIASES_PATH=config/facility_aliases.json
